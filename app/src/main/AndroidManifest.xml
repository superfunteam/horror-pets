<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Built for Android TV, but must stay installable on non-TV devices (and the emulator image). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Offline except PvP Battle, which meets the other player through pets.superfun.games, and the update check, which
         asks GitHub for the latest release on the title. media3 merges ACCESS_NETWORK_STATE in for network playback,
         but the game only plays its own assets. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- The in-app update hands a downloaded release to Android's installer. From Android 8 the player also allows
         installs from this app in Settings, once; without this permission that setting is never offered. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- PvP Battle on phones: tap two phones together to join a room. Never required: TVs have no NFC. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc.hce"
        android:required="false" />

    <!-- allowBackup is off entirely, so there is nothing for dataExtractionRules to describe.
         largeHeap: on API 22-25 (Fire OS 5/6) decoded sprite strips and scenes live on the Java heap. -->
    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.HorrorPets"
        tools:ignore="DataExtractionRules">

        <!-- The game is landscape-only. sensorLandscape lets a phone be turned either way up; a TV has no
             sensor, so there it is plain landscape. The lint note is about phones/tablets.
             configChanges: a Bluetooth remote that drops and reconnects (it sleeps between presses on many
             sticks) changes the keyboard / navigation configuration; the Activity rides that out instead
             of being recreated mid-game. Compose picks the change up by itself. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android's installer reports an update's install here (the session's status PendingIntent, explicit, so
             not exported). -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />

        <!-- A hosting phone's PvP room code, read by a phone tapped against it (host card emulation). -->
        <service
            android:name=".pvp.nfc.PvpTapService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/pvp_tap_service" />
        </service>
    </application>

</manifest>
